{
  "name": "@plexahq/mcp",
  "version": "0.1.0",
  "description": "Plexa: an MCP gateway that connects AI assistants to LayerZero Zero and other EVM chains.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "plexa-mcp": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/http.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p site/tsconfig.json",
    "test": "vitest run",
    "test:live": "PLEXA_LIVE=1 vitest run test/live.test.ts",
    "build:server": "tsc -p tsconfig.json",
    "dev:site": "vite",
    "preview:site": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plexahq/plexahq.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/blob": "^2.9.0",
    "abitype": "^1.2.3",
    "viem": "^2.57.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
