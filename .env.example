# HTTP server
HOST=127.0.0.1
PORT=3000

# Zero (LayerZero) — set once RPCs are published (mainnet launch 2026-11-30)
# PLEXA_RPC_ZERO_ATLAS=
# PLEXA_RPC_ZERO_INTEROP=
# PLEXA_EXPLORER_ZERO_ATLAS=
# PLEXA_EXPLORER_ZERO_INTEROP=

# Override a built-in RPC (recommended in production: public RPCs are rate-limited)
# PLEXA_RPC_ETHEREUM=
# PLEXA_RPC_BASE=
# PLEXA_RPC_ARBITRUM=
# PLEXA_RPC_HYPEREVM=

# Extra chains as JSON
# PLEXA_EXTRA_CHAINS=[{"key":"mychain","name":"My Chain","chainId":777,"rpcUrl":"https://rpc.example","nativeSymbol":"ETH"}]
